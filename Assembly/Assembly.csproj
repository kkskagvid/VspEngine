<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <!-- The C++ host supplies its own runtimeconfig.json (Launch.runtimeconfig.json). -->
        <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>

        <!--
          Standard layout: binaries land under Engine\Intermediate - nothing
          is written into the Source tree. (obj/ and the NuGet restore caches
          are redirected by Directory.Build.props, which is imported early
          enough for MSBuild/NuGet to honor it.)
        -->
        <EngineIntermediateRoot>$(MSBuildProjectDirectory)\..\Engine\Intermediate</EngineIntermediateRoot>
        <OutputPath>$(EngineIntermediateRoot)\Binaries\$(Configuration)_$(Platform)\</OutputPath>
        <OutDir>$(OutputPath)</OutDir>

        <!-- 禁用所有自动添加的子目录 -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
        <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>

        <PlatformTarget>x64</PlatformTarget>
        <OutputType>Library</OutputType>
        <Platforms>x64</Platforms>
        <PackageOutputPath>$(OutputPath)</PackageOutputPath>

        <!-- The game assembly that holds user scripts (loaded by the engine). -->
        <RootNamespace>Assembly</RootNamespace>
        <AssemblyName>Assembly</AssemblyName>

        <!-- Never compile anything from stale local obj/bin folders. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Engine\Source\Runtime\VspEngine\VspEngine.csproj" />
    </ItemGroup>

    <!--
      The game owns its shaders. HLSLCC compiles every .vsf of the Shaders folder
      into the run directory's Shaders folder as SPIR-V plus a shader manifest -
      which is all the engine loads; the engine never compiles HLSL.

      The step is skipped (without failing the build) while HLSLCC.exe has not
      been built yet, and the acceptance run compiles the shaders explicitly, so
      the build works in any project order.
    -->
    <Target Name="CompileGameShaders" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Engine\Tools\Build\CompileShaders.ps1&quot; -ShaderSourceDirectory &quot;$(MSBuildProjectDirectory)\Shaders&quot; -OutputDirectory &quot;$(EngineIntermediateRoot)\Binaries\$(Configuration)_$(Platform)\Shaders&quot;"
              ContinueOnError="true" />
    </Target>

    <!--
      The game owns its translation catalogs too. The engine reads
      <executable directory>Locales<locale>.json, so the build stages them
      next to the executable exactly like the compiled shaders.
    -->
    <Target Name="CopyGameLocales" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <GameLocaleFiles Include="$(MSBuildProjectDirectory)\Locales\*.json" />
        </ItemGroup>
        <Copy SourceFiles="@(GameLocaleFiles)"
              DestinationFolder="$(EngineIntermediateRoot)\Binaries\$(Configuration)_$(Platform)\Locales"
              SkipUnchangedFiles="true"
              ContinueOnError="true" />
    </Target>

</Project>