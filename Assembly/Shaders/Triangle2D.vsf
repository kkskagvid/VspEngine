// ---------------------------------------------------------------------------
// Triangle2D - the demo shader (.vsf).
//
// A .vsf file holds everything one shader needs:
//   Properties  the values the editor shows,
//   Shader      the shader itself: its settings, and one or more Pass blocks,
//   Pass        the shader code - HLSL, with #include and with the entry points
//               named by #pragma vertex / #pragma fragment.
//
// The Pass blocks live INSIDE the Shader block, and a Shader block may hold
// several of them.
//
// The shader draws in 3D: every draw carries its own world matrix, and the
// camera block comes from the camera the game's render pipeline handed to the
// frame. The colored triangle of the demo is one more 3D mesh - the engine has
// no separate 2D path.
//
// HLSLCC turns this file into
//   Triangle2D.vsfo                    the container the ENGINE loads
//   Triangle2D.vert.spv / .frag.spv    the modules, for a graphics debugger
//   Triangle2D.shader.json             the manifest, for tools
//   Triangle2D.reflection.json         the full reflection
// ---------------------------------------------------------------------------

Properties
{
    _ColorMode ("Color Mode", Float) = 3
    _Tint ("Tint", Color) = (1, 1, 1, 1)
}

Shader "Vsp/Triangle2D"
{
    Queue = "Geometry"

    // A strippable keyword group declared in the Shader block: the build keeps
    // only the states it reports as used, so a shader whose _TINT_ENABLED
    // variant nobody uses ships without it.
    Variant _TINT_ENABLED

    Pass
    {
        // Both stage entry points live in this one file.
        #pragma vertex PassVertex
        #pragma fragment PassFragment

        // An "always kept" keyword group: both states are compiled and stay in
        // the build whether they are used or not.
        #pragma multi_variant_local _FLAT_COLOR

        #include "Triangle2DCommon.hlsl"

        // -------------------------------------------------------------------
        // Entry point: vertex stage
        // -------------------------------------------------------------------
        PassVertexOutput PassVertex(PassVertexInput input)
        {
            PassVertexOutput output;

            // Local -> world -> clip. The world matrix is per draw, so one mesh
            // can be drawn anywhere without rebuilding the buffer.
            float4 worldPosition = mul(PushConstants.WorldMatrix, float4(input.Position, 1.0f));
            output.Position = mul(ViewProjectionMatrix, worldPosition);
            output.WorldPosition = worldPosition.xyz;

            // The rotation of the world matrix carries the normal; scaled axes
            // are normalized again so a non-uniform scale cannot tilt it.
            output.WorldNormal = VspSafeNormalize(mul(input.Normal, (float3x3)PushConstants.WorldMatrix), input.Normal);
            output.Color = input.Color;
            output.Uv = input.Uv;
            return output;
        }

        // -------------------------------------------------------------------
        // Entry point: fragment stage
        // -------------------------------------------------------------------
        float4 PassFragment(PassFragmentInput input) : SV_Target0
        {
        #if defined(_FLAT_COLOR)
            // The "always kept" variant: every pixel gets the same color.
            float4 baseColor = PushConstants.TintColor;
        #else
            // Vertex colors are the demo's multicolor mode; every other mode
            // replaces them with the flat override color.
            float4 baseColor = (PushConstants.ColorMode == 3) ? input.Color : PushConstants.BaseColor;
        #endif

        #if defined(_TINT_ENABLED)
            // The strippable variant: the material's tint multiplies the result.
            baseColor *= PushConstants.TintColor;
        #endif

            // One directional light, shaded with the builtin library's helpers.
            // The demo texture is white, so multiplying by it keeps the colors
            // exact while the bindless lookup is exercised on every pixel.
            float3 normal = VspSafeNormalize(input.WorldNormal, float3(0.0f, 0.0f, 1.0f));
            float3 directionToLight = VspSafeNormalize(-PushConstants.LightDirection.xyz, float3(0.0f, 0.0f, 1.0f));
            float fDiffuse = VspSaturate(dot(normal, directionToLight)) * PushConstants.LightDirection.w;

            // A highlight the 2D content switches off (specular strength 0), so
            // its pixels are exactly the material color.
            float3 viewDirection = VspViewDirection(input.WorldPosition, CameraPosition.xyz);
            float3 halfVector = VspSafeNormalize(directionToLight + viewDirection, normal);
            float fSpecularPower = VspRemap(PushConstants.Roughness, 0.0f, 1.0f, 128.0f, 8.0f);
            float fSpecular = pow(VspSaturate(dot(normal, halfVector)), fSpecularPower) * PushConstants.SpecularStrength;

            float3 sampledColor = VspSampleTexture(PushConstants.TextureIndex, input.Uv).rgb;
            float3 litColor = baseColor.rgb * sampledColor * (fDiffuse + fSpecular);
            return float4(litColor, baseColor.a);
        }
    }
}
