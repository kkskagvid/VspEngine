<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The C++ host supplies its own runtimeconfig.json (Launch.runtimeconfig.json). -->
        <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>

        <OutputPath>$(SolutionDir)Engine\Intermediate\Binaries\$(Configuration)_$(Platform)\</OutputPath>
        <OutDir>$(OutputPath)</OutDir>

        <!-- 禁用所有自动添加的子目录 -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
        <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>

        <PlatformTarget>x64</PlatformTarget>
        <OutputType>Library</OutputType>
        <Platforms>x64</Platforms>
        <PackageOutputPath>$(OutputPath)</PackageOutputPath>

        <IntermediateOutputPath>$(SolutionDir)Engine\Intermediate\Object\$(Configuration)_$(Platform)\$(MSBuildProjectName)\</IntermediateOutputPath>

        <RootNamespace>VspEngine</RootNamespace>
    </PropertyGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="rd &quot;$(ProjectDir)obj&quot; /s /q" />
    </Target>

</Project>