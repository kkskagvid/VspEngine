// ---------------------------------------------------------------------------
// MultiPassTest - a shader whose Shader block holds TWO Pass blocks.
//
// The acceptance run compiles it to prove that a Shader block may carry several
// Pass blocks and that every one of them is compiled on its own.
//
// The asset is deliberately SELF-CONTAINED: it declares the vertex layout, the
// push-constant block and the camera block it reads inside its own Pass blocks
// and includes nothing, so the compiler test never depends on a game shader that
// a later change to the demo could rename or delete.
//
// The declarations it repeats are the engine's contract, not the demo's: four
// vertex attributes, one camera uniform buffer and one push-constant block. The
// ENGINE decides the binding of every one of them (see
// VspCore/Graphics/ShaderBindings.h), and this file writes none.
// ---------------------------------------------------------------------------

Properties
{
    _ColorMode ("Color Mode", Float) = 3
    _Tint ("Tint", Color) = (1, 1, 1, 1)
}

Shader "Vsp/MultiPassTest"
{
    Queue = "Geometry"

    Pass "Forward"
    {
        #pragma vertex PassVertex
        #pragma fragment PassFragment

        struct MultiPassVertexInput
        {
            VSP_VK_LOCATION(0) float3 Position : POSITION;
            VSP_VK_LOCATION(1) float3 Normal   : NORMAL;
            VSP_VK_LOCATION(2) float4 Color    : COLOR;
            VSP_VK_LOCATION(3) float2 Uv       : TEXCOORD0;
        };

        struct MultiPassVertexOutput
        {
            float4 Position : SV_Position;
            VSP_VK_LOCATION(0) float3 WorldPosition : TEXCOORD0;
            VSP_VK_LOCATION(1) float3 WorldNormal   : TEXCOORD1;
            VSP_VK_LOCATION(2) float4 Color         : TEXCOORD2;
        };

        struct MultiPassFragmentInput
        {
            VSP_VK_LOCATION(0) float3 WorldPosition : TEXCOORD0;
            VSP_VK_LOCATION(1) float3 WorldNormal   : TEXCOORD1;
            VSP_VK_LOCATION(2) float4 Color         : TEXCOORD2;
        };

        struct MultiPassPushConstants
        {
            row_major float4x4 WorldMatrix;      // offset 0
            VSP_VK_OFFSET(64)  float4 BaseColor;        // offset 64
            VSP_VK_OFFSET(80)  float4 LightDirection;   // offset 80
            VSP_VK_OFFSET(96)  float4 AmbientColor;     // offset 96
        };
        [[vk::push_constant]] ConstantBuffer<MultiPassPushConstants> PushConstants;

        cbuffer CameraUniformBuffer
        {
            column_major float4x4 ViewProjectionMatrix;
            column_major float4x4 ViewMatrix;
            column_major float4x4 ProjectionMatrix;
            column_major float4x4 CameraToWorldMatrix;
            float4 CameraPosition;
            float4 CameraLens;
        };

        #include <Vsp/Common.hlsl>

        MultiPassVertexOutput PassVertex(MultiPassVertexInput input)
        {
            MultiPassVertexOutput output;
            float4 worldPosition = mul(PushConstants.WorldMatrix, float4(input.Position, 1.0f));
            output.Position = mul(ViewProjectionMatrix, worldPosition);
            output.WorldPosition = worldPosition.xyz;
            output.WorldNormal = VspSafeNormalize(mul(input.Normal, (float3x3)PushConstants.WorldMatrix), input.Normal);
            output.Color = input.Color;
            return output;
        }

        float4 PassFragment(MultiPassFragmentInput input) : SV_Target0
        {
            return input.Color * PushConstants.BaseColor;
        }
    }

    Pass "Tinted"
    {
        #pragma vertex PassVertex
        #pragma fragment PassFragment
        #pragma variant _TINT_ENABLED

        struct MultiPassVertexInput
        {
            VSP_VK_LOCATION(0) float3 Position : POSITION;
            VSP_VK_LOCATION(1) float3 Normal   : NORMAL;
            VSP_VK_LOCATION(2) float4 Color    : COLOR;
            VSP_VK_LOCATION(3) float2 Uv       : TEXCOORD0;
        };

        struct MultiPassVertexOutput
        {
            float4 Position : SV_Position;
            VSP_VK_LOCATION(0) float3 WorldPosition : TEXCOORD0;
            VSP_VK_LOCATION(1) float3 WorldNormal   : TEXCOORD1;
            VSP_VK_LOCATION(2) float4 Color         : TEXCOORD2;
        };

        struct MultiPassFragmentInput
        {
            VSP_VK_LOCATION(0) float3 WorldPosition : TEXCOORD0;
            VSP_VK_LOCATION(1) float3 WorldNormal   : TEXCOORD1;
            VSP_VK_LOCATION(2) float4 Color         : TEXCOORD2;
        };

        struct MultiPassPushConstants
        {
            row_major float4x4 WorldMatrix;      // offset 0
            VSP_VK_OFFSET(64)  float4 BaseColor;        // offset 64
            VSP_VK_OFFSET(80)  float4 LightDirection;   // offset 80
            VSP_VK_OFFSET(96)  float4 AmbientColor;     // offset 96
        };
        [[vk::push_constant]] ConstantBuffer<MultiPassPushConstants> PushConstants;

        cbuffer CameraUniformBuffer
        {
            column_major float4x4 ViewProjectionMatrix;
            column_major float4x4 ViewMatrix;
            column_major float4x4 ProjectionMatrix;
            column_major float4x4 CameraToWorldMatrix;
            float4 CameraPosition;
            float4 CameraLens;
        };

        #include <Vsp/Common.hlsl>

        MultiPassVertexOutput PassVertex(MultiPassVertexInput input)
        {
            MultiPassVertexOutput output;
            float4 worldPosition = mul(PushConstants.WorldMatrix, float4(input.Position, 1.0f));
            output.Position = mul(ViewProjectionMatrix, worldPosition);
            output.WorldPosition = worldPosition.xyz;
            output.WorldNormal = VspSafeNormalize(mul(input.Normal, (float3x3)PushConstants.WorldMatrix), input.Normal);
            output.Color = input.Color;
            return output;
        }

        float4 PassFragment(MultiPassFragmentInput input) : SV_Target0
        {
        #if defined(_TINT_ENABLED)
            return input.Color * PushConstants.BaseColor * float4(0.5f, 0.5f, 0.5f, 1.0f);
        #else
            return input.Color * PushConstants.BaseColor;
        #endif
        }
    }
}
